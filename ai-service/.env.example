GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Maximum time to wait for one Gemini request, in milliseconds.
GEMINI_REQUEST_TIMEOUT_MS=55000
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Keep RAG prompts small enough to stay focused and inexpensive.
RAG_MAX_CONTEXT_CHUNKS=4
RAG_MAX_CONTEXT_CHARS=7000
AI_SERVICE_TOKEN=replace-with-the-same-long-local-value-as-server-env
# Create a Qdrant Cloud cluster, then copy its URL and Database API key here.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=ai_notes_chunks
# Set true only if default TLS connections reset but verified TLS 1.2 succeeds.
# Keep false on deployments unless the same connection problem is reproduced.
QDRANT_FORCE_TLS12=false
